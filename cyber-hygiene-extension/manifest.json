{
  "manifest_version": 3,
  "name": "Cyber Hygiene \u2014 Connection & Exposure",
  "version": "0.1.0",
  "description": "Inspect TLS connections and explicitly check password exposure using a local hash and a five-character prefix.",
  "permissions": [
    "activeTab",
    "webRequest",
    "webRequestBlocking"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Cyber Hygiene",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cyber-hygiene@josephchitalu2.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "authenticationInfo"
        ]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
